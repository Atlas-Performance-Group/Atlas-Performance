# --- Painel de Métricas Atlas ---
MONGODB_URI=
MONGODB_DB=painel_metricas_atlas
ADMIN_PASSWORD=
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Atlas Rastreador (monitoramento/geolocalização de IP) ---
# Provedor secundário/fallback de geolocalização (opcional). Sem esta
# variável, o sistema usa só o ip-api.com (gratuito, sem chave).
IPINFO_TOKEN=

# Horas que um resultado de geolocalização fica em cache antes de consultar
# o provedor de novo para o mesmo IP.
IP_GEO_CACHE_TTL_HOURS=24

# Dias de retenção dos eventos brutos de acesso (ip_access_events). Os
# registros agregados por IP não são apagados pela retenção.
ATLAS_RASTREADOR_RETENTION_DAYS=90

# Secret usado pelo Vercel Cron para chamar /api/rastreador/cleanup sem
# sessão de admin (o Vercel injeta automaticamente o header
# "Authorization: Bearer $CRON_SECRET" nas chamadas de cron quando esta
# variável está configurada no projeto).
CRON_SECRET=
