# --- Atlas Rastreador ---
# Banco próprio, independente do painel-metricas. Pode apontar para o mesmo
# cluster MongoDB Atlas contanto que MONGODB_DB seja diferente.
MONGODB_URI=
MONGODB_DB=atlas_rastreador

# Login do painel (independente da senha do painel-metricas).
ADMIN_PASSWORD=
SESSION_SECRET=

# Secret compartilhado que outros sistemas Atlas (painel-metricas, sites
# institucionais, etc.) usam para reportar acessos via POST /api/ingest,
# com header "Authorization: Bearer <INGEST_SECRET>".
INGEST_SECRET=

# Provedor secundário/fallback de geolocalização (opcional). Sem esta
# variável, o sistema usa só o ip-api.com (gratuito, sem chave).
IPINFO_TOKEN=

# Horas que um resultado de geolocalização fica em cache antes de consultar
# o provedor de novo para o mesmo IP.
IP_GEO_CACHE_TTL_HOURS=24

# Dias de retenção dos eventos brutos de acesso (ip_access_events). Os
# registros agregados por IP não são apagados pela retenção.
ATLAS_RASTREADOR_RETENTION_DAYS=90

# Secret usado pelo Vercel Cron para chamar /api/cleanup sem sessão de
# admin (o Vercel injeta automaticamente "Authorization: Bearer $CRON_SECRET"
# nas chamadas de cron quando esta variável está configurada no projeto).
CRON_SECRET=
